# Caddy перед selfsync в режиме socket (systemd socket activation) или serve.
notes.example.com {
	request_body {
		max_size 17MB
	}

	@selfsync path /v1/* /join/*
	reverse_proxy @selfsync 127.0.0.1:8085 {
		# или Unix-сокет: reverse_proxy @selfsync unix//run/selfsync/selfsync.sock
		# Long-poll /v1/wait держит запрос до 25 с — таймауты больше.
		transport http {
			read_timeout 60s
			write_timeout 60s
		}
		# Range-ответы и большие тела — потоком.
		flush_interval -1
		# Caddy сам передаёт адрес клиента в X-Forwarded-For (присланный клиентом
		# заголовок не доверенный и отбрасывается). Чтобы лимит неудачных попыток
		# считал по клиентам, а не по адресу Caddy: SELFSYNC_TRUSTED_PROXY=1.
	}

	respond 404
}

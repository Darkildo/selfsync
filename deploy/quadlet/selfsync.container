[Unit]
Description=selfsync (socket-activated container)
Requires=selfsync.socket
After=selfsync.socket

[Container]
# Образ из бинаря релиза server-X.Y.Z (amd64, arm64). Версия указана явно: при
# обновлении поменяйте её и выполните
#   systemctl --user daemon-reload && systemctl --user restart selfsync.socket
# Собрать тот же образ у себя, без реестра (из корня репозитория):
#   podman build -t localhost/selfsync:local --build-arg VERSION=X.Y.Z deploy/quickstart
# и указать Image=localhost/selfsync:local, Pull=never.
Image=ghcr.io/darkildo/selfsync:0.10.1
Pull=missing
Exec=socket --idle-timeout 10m
Volume=%h/selfsync-data:/data:Z
ReadOnly=true
Tmpfs=/tmp
DropCapability=ALL
NoNewPrivileges=true
Notify=true
Environment=SELFSYNC_DATA_DIR=/data
#Environment=SELFSYNC_PUBLIC_URL=https://notes.example.com
#Environment=SELFSYNC_TRUSTED_PROXY=1

[Service]
# Выход по простою — штатное завершение.
Restart=no
TimeoutStartSec=60

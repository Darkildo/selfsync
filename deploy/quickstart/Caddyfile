# Caddy перед selfsync: сертификат Let's Encrypt для {$DOMAIN}, лимиты и таймауты
# под selfsync (большие файлы частями до 16 МиБ, long-poll до 25 с).
{
	email {$EMAIL}
}

{$DOMAIN} {
	request_body {
		max_size 17MB
	}

	@selfsync path /v1/* /join/*
	reverse_proxy @selfsync selfsync:8085 {
		transport http {
			read_timeout 60s
			write_timeout 60s
		}
		flush_interval -1
	}

	respond 404
}

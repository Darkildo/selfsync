# Стирает удалённые файлы с истёкшим окном хранения. Без постоянного процесса
# таймера внутри сервера нет — его роль играет notesync-sweep.timer.
[Unit]
Description=notesync: erase deleted files past the retention window

[Service]
Type=oneshot
ExecStart=/usr/local/bin/notesync sweep
DynamicUser=yes
User=notesync
Group=notesync
StateDirectory=notesync
StateDirectoryMode=0700
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
NoNewPrivileges=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_UNIX
SystemCallFilter=@system-service
CapabilityBoundingSet=
UMask=0077

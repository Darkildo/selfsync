# Стирает удалённые файлы с истёкшим окном хранения. Без постоянного процесса
# таймера внутри сервера нет — его роль играет selfsync-sweep.timer.
[Unit]
Description=selfsync: erase deleted files past the retention window

[Service]
Type=oneshot
ExecStart=/usr/local/bin/selfsync sweep
DynamicUser=yes
User=selfsync
Group=selfsync
StateDirectory=selfsync
StateDirectoryMode=0700
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
NoNewPrivileges=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_UNIX
SystemCallFilter=@system-service
CapabilityBoundingSet=
UMask=0077

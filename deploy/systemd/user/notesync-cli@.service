# Пользовательская служба консольного клиента: синхронизирует папку %h/<экземпляр>.
#
#   cp notesync-cli@.service ~/.config/systemd/user/
#   notesync-cli connect --dir ~/notes --server https://example.com/notesync --code КОД
#   systemctl --user enable --now notesync-cli@notes.service
#
# Для папки с «/» в пути имя экземпляра экранируйте: systemd-escape --path.
# Зашифрованный vault: один раз `notesync-cli run --once --password-file …` —
# ключ запомнится в .notesync/key, и служба будет стартовать без пароля.

[Unit]
Description=notesync: синхронизация папки %h/%I
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=%h/.local/bin/notesync-cli run --dir %h/%I
Restart=on-failure
RestartSec=30
Environment=NOTESYNC_LOG=info

[Install]
WantedBy=default.target

# Пользовательская служба консольного клиента: синхронизирует папку %h/<экземпляр>.
#
#   cp selfsync-cli@.service ~/.config/systemd/user/
#   selfsync-cli connect --dir ~/notes --server https://example.com/selfsync --code КОД
#   systemctl --user enable --now selfsync-cli@notes.service
#
# Для папки с «/» в пути имя экземпляра экранируйте: systemd-escape --path.
# Зашифрованный vault: один раз `selfsync-cli run --once --password-file …` —
# ключ запомнится в .selfsync/key, и служба будет стартовать без пароля.

[Unit]
Description=selfsync: синхронизация папки %h/%I
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=%h/.local/bin/selfsync-cli run --dir %h/%I
Restart=on-failure
RestartSec=30
Environment=SELFSYNC_LOG=info

[Install]
WantedBy=default.target
